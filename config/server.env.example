# 公网 IP + HTTP 源码部署。复制为 config/server.env 后使用：
# node --env-file=config/server.env server/index.js
# HTTP 不加密密码和 Cookie；以后启用 HTTPS 时把 SP_AUTH_COOKIE_SECURE 改为 1。
HOST=0.0.0.0
PORT=3000
SP_AUTH=on
SP_AUTH_COOKIE_SECURE=0
SP_AUTH_SESSION_HOURS=12
SP_RANKED=on
SP_RANKED_MAX_MATCHES=4
# 新部署默认持久化目录：项目根目录/storage。
# 旧 config 数据会继续读取；迁移后工具写入此配置。也可使用固定绝对路径。
# SP_STATE_DIR=/var/lib/stronghold-protocol
